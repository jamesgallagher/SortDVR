# Copy to .env and fill in. .env is gitignored — never commit real keys.
DISPATCHARR_URL=http://192.168.0.148:9191
DISPATCHARR_API_KEY=your-key-here

# Destination folders (leave blank during dry-run/scan)
INBOX=/data/recordings
TV_DIR=
MOVIE_DIR=
SPORT_DIR=

TZ=UTC

# Second pass: gemini | groq | none
LLM_PROVIDER=none
LLM_API_KEY=
# Groq model (optional). Default openai/gpt-oss-120b; llama-3.3-70b decommissioned 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b

COMSKIP_ENABLED=true
SETTLE_MINUTES=15
POLL_INTERVAL=30

# Optional: comma-separated show names forced to TV
TV_WHITELIST=
